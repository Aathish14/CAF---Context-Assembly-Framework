# Environment Variables Template
# Copy this file to .env and customize for your environment

# Application Settings
APP_NAME=Context Assembly Framework
APP_VERSION=0.1.0
DEBUG=False

# Database
DATABASE_URL=sqlite:///./caf.db
DATABASE_ECHO=False

# Security
SECRET_KEY=change-me-in-production-generate-a-secure-random-key

# File Paths
UPLOAD_DIR=./uploads
TEMPLATE_DIR=./caf/templates

# Logging
LOG_LEVEL=INFO

# NVIDIA NIM API Key (for Enterprise AI Runtime)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here